---
interface Props {
  title: string
  description: string
  /** Pages without an address of their own, such as the 404 page, have no canonical URL. */
  canonical?: boolean
}

const { title, description, canonical = true } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const imageUrl = new URL("/social-card.png", Astro.site)
---

{canonical && <link rel="canonical" href={canonicalUrl} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="OpenTUI" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="OpenTUI" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content="OpenTUI" />
