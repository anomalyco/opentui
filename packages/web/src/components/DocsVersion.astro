---
// Names the documentation's version in the site header. The current version opens the channel's releases page; the
// other label switches to the same page in its channel and carries data-docs-channel for the site validator.
import { channelCounterpart, channelUrl, pageChannel } from "../lib/docs-channel"

const channel = pageChannel(Astro.url.pathname)
const path = Astro.url.pathname.replace(/\/+$/, "") || "/"
const releasesHref = channelUrl("/docs/releases", channel)
const choices = (["stable", "next"] as const).map((id) => {
  const label = id === "stable" ? channel.release : "next"
  if (id === channel.id) {
    return {
      id,
      label,
      href: releasesHref,
      title: id === "stable" ? "Release notes and API changes" : "Release notes and unreleased API changes",
      current: path === releasesHref ? ("page" as const) : ("true" as const),
    }
  }
  const target = channelCounterpart(path, channel, id)
  const title =
    id === "stable"
      ? `Documentation for the ${channel.release} release`
      : "Documentation for the main branch, including unreleased changes"
  return {
    id,
    label,
    href: target.href,
    title: target.present ? title : `${title}. It does not have this page.`,
    current: undefined,
  }
})
---

<nav class="docs-version" aria-label="Documentation version">
  {
    choices.map(({ id, label, title, href, current }) => (
      <a {href} {title} data-docs-channel={current ? undefined : id} aria-current={current}>
        {label}
      </a>
    ))
  }
</nav>

<style>
  .docs-version {
    display: flex;
    gap: 2ch;
  }

  /* The current version uses the text color and opens Releases; the other
   * channel stays in the link color. */
  a[aria-current] {
    color: inherit;
  }

  /* Below 23rem the header cannot hold the wordmark, Menu, and both
   * labels on one row, with a desktop scrollbar gutter and a two-digit
   * minor version. Keep the current version; the main-branch notice still
   * links back to the release. */
  @media (max-width: 23rem) {
    a:not([aria-current]) {
      display: none;
    }
  }
</style>
