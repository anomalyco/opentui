---
import { getCollection, render, type CollectionEntry } from "astro:content"
import ProseCode from "../../components/ProseCode.astro"
import ProseTable from "../../components/ProseTable.astro"
import Scrollback from "../../layouts/Scrollback.astro"

export async function getStaticPaths() {
  const posts = (await getCollection("scrollback")).filter((post) => (import.meta.env.PROD ? !post.data.draft : true))

  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"scrollback">
}

const { entry } = Astro.props
const { Content } = await render(entry)
const date = entry.data.date.toISOString().slice(0, 10)
---

<Scrollback
  title={`${entry.data.title} | OpenTUI Scrollback`}
  description={entry.data.description ?? "Development notes from OpenTUI."}
  footerLinks
  footerAnimation="inchworm"
>
  <article class="scrollback-post">
    <header>
      <h1>{entry.data.title}</h1>
      <p class="scrollback-meta">
        <time datetime={date}>{date}</time>
      </p>
    </header>

    <div class="prose">
      <Content components={{ pre: ProseCode, table: ProseTable }} />
    </div>
  </article>
</Scrollback>
