---
import OpenTUILogo from "../components/OpenTUILogo.astro"
import SiteFooter from "../components/SiteFooter.astro"
import landingVideos from "../data/landing-videos.json"
import Minimal from "../layouts/Minimal.astro"

const description =
  "OpenTUI is a library to build terminal user interfaces in TypeScript, React, or Solid, on a native Zig renderer."
const title = "OpenTUI"
const videos = Object.fromEntries(landingVideos.map((video) => [video.slug, video]))
---

<Minimal {title} description={description}>
  <main class="reading">
    <header>
      <h1><OpenTUILogo class="logo" title="OpenTUI" /></h1>
      <p>A library to build terminal user interfaces.</p>
    </header>

    <div class="band">
      <div class="screen" id="feature-video" aria-hidden="true">
        <div class="video-frame">
          <video muted loop playsinline preload="metadata"></video>
          <button class="audio-toggle" type="button" aria-label="Enable audio" title="Enable audio" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5L8 9H4z"></path>
              <path class="sound-on" d="M16 9a4 4 0 0 1 0 6m2.5-8.5a7.5 7.5 0 0 1 0 11"></path>
              <path class="sound-off" d="m16.5 9.5 5 5m0-5-5 5"></path>
            </svg>
          </button>
        </div>
        <p class="caption"><span></span> <a href=""></a>.</p>
      </div>

      <div class="copy">
        <ul>
          <li>
            <button
              type="button"
              data-video={videos.video.file}
              data-source={videos.video.source}
              data-credit={videos.video.credit}
              data-has-audio={videos.video.hasAudio}
              data-author={`@${videos.video.handle}`}>It is written in Zig.</button
            >
          </li>
          <li>
            <button
              type="button"
              data-video={videos.components.file}
              data-source={videos.components.source}
              data-credit={videos.components.credit}
              data-has-audio={videos.components.hasAudio}
              data-author={`@${videos.components.handle}`}
            >
              You write TypeScript directly or through React and Solid.
            </button>
          </li>
          <li>
            <button
              type="button"
              data-video={videos.images.file}
              data-source={videos.images.source}
              data-credit={videos.images.credit}
              data-has-audio={videos.images.hasAudio}
              data-author={`@${videos.images.handle}`}>You arrange boxes and text with flexbox.</button
            >
          </li>
          <li>
            <button
              type="button"
              data-video={videos.editor.file}
              data-source={videos.editor.source}
              data-credit={videos.editor.credit}
              data-has-audio={videos.editor.hasAudio}
              data-author={`@${videos.editor.handle}`}
            >
              You add selects, inputs, and scroll boxes with keyboard and mouse controls.
            </button>
          </li>
          <li>
            <button
              type="button"
              data-video={videos["3d"].file}
              data-source={videos["3d"].source}
              data-credit={videos["3d"].credit}
              data-has-audio={videos["3d"].hasAudio}
              data-author={`@${videos["3d"].handle}`}
            >
              You can play sounds, show images, and render 3D graphics.
            </button>
          </li>
        </ul>

        <p>OpenCode uses it in production for millions of users.</p>

        <SiteFooter links animation="hopper" />
      </div>
    </div>
  </main>

  <script>
    const band = document.querySelector<HTMLElement>(".band")!
    const screen = band.querySelector<HTMLElement>(".screen")!
    const video = band.querySelector("video")!
    const audioToggle = band.querySelector<HTMLButtonElement>(".audio-toggle")!
    const caption = band.querySelector<HTMLElement>(".caption")!
    const credit = caption.querySelector("span")!
    const source = caption.querySelector("a")!
    const list = band.querySelector("ul")!
    const points = [...band.querySelectorAll<HTMLButtonElement>("button[data-video]")]
    let current: HTMLButtonElement | null = null

    for (const point of points) {
      point.setAttribute("aria-controls", "feature-video")
      point.setAttribute("aria-expanded", "false")
    }

    function open(point: HTMLButtonElement) {
      const src = point.dataset.video!
      if (video.getAttribute("src") !== src) video.setAttribute("src", src)
      source.href = point.dataset.source!
      source.textContent = point.dataset.author!
      credit.textContent = point.dataset.credit!
      audioToggle.hidden = point.dataset.hasAudio !== "true"
      video.play().catch(() => {})
      band.classList.add("playing")
      screen.setAttribute("aria-hidden", "false")
      current = point

      for (const candidate of points) {
        const active = candidate === point
        candidate.classList.toggle("active", active)
        candidate.setAttribute("aria-expanded", String(active))
      }

      requestAnimationFrame(() => {
        requestAnimationFrame(async () => {
          if (getComputedStyle(screen).position !== "static") return
          await Promise.allSettled(band.getAnimations().map((animation) => animation.finished))
          if (current !== point) return

          const mediaBounds = screen.getBoundingClientRect()
          const pointBounds = point.getBoundingClientRect()
          const padding = 16
          const top = Math.min(mediaBounds.top, pointBounds.top)
          const bottom = Math.max(mediaBounds.bottom, pointBounds.bottom)
          const availableHeight = innerHeight - 2 * padding
          let offset = 0

          if (bottom - top <= availableHeight) {
            if (top < padding) offset = top - padding
            else if (bottom > innerHeight - padding) offset = bottom - innerHeight + padding
          } else if (pointBounds.bottom > innerHeight - padding) {
            offset = pointBounds.bottom - innerHeight + padding
          } else if (pointBounds.top < padding) {
            offset = pointBounds.top - padding
          }

          if (offset) scrollBy({ top: offset, behavior: "smooth" })
        })
      })
    }

    audioToggle.addEventListener("click", () => {
      video.muted = !video.muted
      const label = video.muted ? "Enable audio" : "Mute audio"
      audioToggle.dataset.muted = String(video.muted)
      audioToggle.ariaLabel = label
      audioToggle.title = label
      if (video.paused) video.play().catch(() => {})
    })

    function close(restoreFocus = false) {
      const activePoint = current
      band.classList.remove("playing")
      screen.setAttribute("aria-hidden", "true")
      video.pause()
      current = null

      for (const point of points) {
        point.classList.remove("active")
        point.setAttribute("aria-expanded", "false")
      }

      if (restoreFocus) activePoint?.focus()
    }

    for (const point of points) {
      point.addEventListener("click", () => {
        if (current === point) close()
        else open(point)
      })
    }

    const steps: Record<string, number> = { ArrowDown: 1, j: 1, ArrowUp: -1, k: -1 }
    window.addEventListener("keydown", (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return
      if (event.key === "Escape") {
        if (current) close(true)
        return
      }

      const step = steps[event.key]
      if (!step) return

      const scrollable = document.documentElement.scrollHeight > innerHeight
      if (event.key.startsWith("Arrow") && scrollable && !list.contains(document.activeElement)) return

      event.preventDefault()
      const index = current ? points.indexOf(current) : step > 0 ? -1 : 0
      const point = points[(index + step + points.length) % points.length]!
      point.focus()
      open(point)
    })
  </script>
</Minimal>

<style>
  .logo {
    display: block;
    width: 250px;
    height: 60px;
  }

  /* One blank line (1.5rem) separates the wordmark, tagline, list, claim,
   * and footer: the same line grid as the article pages. */
  header h1 {
    margin-block: 0 1.5rem;
  }

  header p {
    margin-block: 0;
  }

  .band {
    position: relative;
    width: 100%;
    margin-block: 1.5rem;
    transition: width var(--motion-step) linear var(--motion-step);
  }

  .band.playing {
    width: min(54rem, calc(50vw + var(--content-width) / 2 - var(--page-gutter)));
    min-height: calc(20rem * 4 / 5 + 1.875rem);
    transition-delay: 0ms;
  }

  .screen {
    position: absolute;
    inset: -2.5em 0 auto auto;
    width: 20rem;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
    visibility: hidden;
    transition:
      clip-path var(--motion-step) linear,
      visibility 0ms linear var(--motion-step);
  }

  .band.playing .screen {
    clip-path: inset(0);
    visibility: visible;
    transition-delay: var(--motion-step), var(--motion-step);
  }

  .copy {
    width: 100%;
    transition: width var(--motion-step) linear var(--motion-step);
  }

  .band.playing .copy {
    width: calc(100% - 21.5rem);
    transition-delay: 0ms;
  }

  .band ul {
    margin-block: 0;
  }

  .copy p {
    margin-block: 1.5rem 0;
  }

  .screen video {
    display: block;
    width: 100%;
    object-fit: contain;
    aspect-ratio: 5 / 4;
    background: #000;
  }

  .video-frame {
    position: relative;
  }

  .audio-toggle {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    padding: 0.5rem;
    place-items: center;
    border: 0;
    border-radius: 0;
    background: #000c;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
  }

  .audio-toggle:focus-visible {
    outline: 1px solid #fff;
    outline-offset: 2px;
  }

  .audio-toggle[hidden] {
    display: none;
  }

  .audio-toggle svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .audio-toggle .sound-on,
  .audio-toggle:not([data-muted="false"]) .sound-off {
    fill: none;
  }

  .audio-toggle[data-muted="false"] .sound-off,
  .audio-toggle:not([data-muted="false"]) .sound-on {
    display: none;
  }

  .caption {
    margin-block: 0.375rem 0;
    font-size: var(--text-caption);
    color: var(--muted-color);
    pointer-events: auto;
  }

  button[data-video] {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  button[data-video]:hover {
    text-decoration: underline;
  }

  @media (max-width: 64rem) {
    .band,
    .band.playing {
      position: static;
      display: grid;
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 0fr auto;
      row-gap: 0;
      min-height: 0;
      transition:
        grid-template-rows calc(2 * var(--motion-step)) linear,
        row-gap calc(2 * var(--motion-step)) linear;
    }

    .band.playing {
      grid-template-rows: 1fr auto;
      row-gap: 1.5rem;
    }

    .screen {
      position: static;
      inset: auto;
      width: min(100%, 26rem);
      min-height: 0;
      grid-column: 1;
      grid-row: 1;
      clip-path: none;
      transition: visibility 0ms linear calc(2 * var(--motion-step));
    }

    .band.playing .screen {
      transition-delay: 0ms;
    }

    .copy,
    .band.playing .copy {
      width: auto;
      grid-column: 1;
      grid-row: 2;
      transition: none;
    }
  }

  @media (max-width: 40rem) {
    .logo {
      width: 200px;
      height: 48px;
    }

    .band ul {
      padding-inline-start: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band,
    .screen,
    .band ul {
      transition: none;
    }
  }
</style>
