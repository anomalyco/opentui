---
import { getCollection } from "astro:content"
import Scrollback from "../layouts/Scrollback.astro"

const posts = (await getCollection("scrollback"))
  .filter((post) => (import.meta.env.PROD ? !post.data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const isoDate = (date: Date) => date.toISOString().slice(0, 10)
---

<Scrollback title="Scrollback | OpenTUI" description="Development notes from OpenTUI.">
  <h1 class="sr-only">Scrollback</h1>

  <ul>
    {
      posts.map((post) => (
        <li>
          <p class="title">
            <a href={`/scrollback/${post.id}`}>{post.data.title}</a>
            <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
          </p>
          {post.data.description && <p class="excerpt">{post.data.description}</p>}
        </li>
      ))
    }
  </ul>
</Scrollback>

<style>
  ul {
    margin-block: 0;
    padding: 0;
    list-style: none;
  }

  /* Each entry is two lines: the title with its gray date trailing on
   * the same line, then the excerpt. Whitespace alone keeps entries
   * apart. The gap is two character cells, like two spaces in terminal
   * output. */
  li + li {
    margin-block-start: 2rem;
  }

  .title {
    margin: 0;
  }

  .title a {
    font-weight: bold;
  }

  .title time {
    margin-inline-start: 2ch;
    color: var(--muted-color);
  }

  /* On the narrowest screens an inline date crowds the title, so it
   * drops to its own line. */
  @media (max-width: 30rem) {
    .title time {
      display: block;
      margin-inline-start: 0;
    }
  }

  .excerpt {
    margin-block: 0.5rem 0;
  }
</style>
