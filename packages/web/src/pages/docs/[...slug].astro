---
import { getCollection, render } from "astro:content"
import ProseCode from "../../components/ProseCode.astro"
import ProseH2 from "../../components/ProseH2.astro"
import ProseH3 from "../../components/ProseH3.astro"
import ProseTable from "../../components/ProseTable.astro"
import Docs from "../../layouts/Docs.astro"
import { buildDocsIndex } from "../../lib/docs-index"

export async function getStaticPaths() {
  const [docs, docsIndex] = await Promise.all([getCollection("docs"), buildDocsIndex()])
  const entriesById = Object.fromEntries(docs.map((entry) => [entry.id, entry]))

  return docsIndex.pages
    .filter((page) => page.url !== "/docs")
    .map((page) => ({
      params: { slug: page.slug },
      props: { entry: entriesById[page.sourceId], page },
    }))
}

const { entry, page } = Astro.props
if (!entry || !page) throw new Error("Missing documentation route entry")
const { Content, headings } = await render(entry)
---

<Docs title={entry.data.title} description={entry.data.description} slug={page.slug} headings={headings}>
  <Content components={{ pre: ProseCode, table: ProseTable, h2: ProseH2, h3: ProseH3 }} />
</Docs>
