---
import type { MarkdownHeading } from "astro"
import DocsNav from "../components/DocsNav.astro"
import DocsToc from "../components/DocsToc.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteNav from "../components/SiteNav.astro"
import { buildDocsIndex, getPrevNextDocSequences } from "../lib/docs-index"
import Minimal from "./Minimal.astro"
import "../styles/prose.css"

interface Props {
  title: string
  description?: string
  slug: string
  headings?: MarkdownHeading[]
}

const { title, description, slug, headings = [] } = Astro.props
const docsIndex = await buildDocsIndex()
const sequencePagers = getPrevNextDocSequences(docsIndex, slug).filter(({ prev, next }) => prev || next)
const hasSections = headings.some((heading) => heading.depth === 2)
---

<Minimal title={`${title} | OpenTUI Docs`} description={description ?? "OpenTUI documentation."} wide>
  <Fragment slot="nav">
    <a class="skip" href="#docs-content">Skip to content</a>

    <SiteNav>
      <DocsNav slot="menu" />
      {
        hasSections && (
          <div class="subnav" slot="subnav">
            <div class="bar">
              <details class="onpage">
                <summary>
                  On this page<span class="current-section" data-current-section />
                </summary>
                <div class="pane">
                  <div class="pane-content">
                    <DocsToc headings={headings} />
                  </div>
                </div>
              </details>
            </div>
          </div>
        )
      }
    </SiteNav>
  </Fragment>

  <div class:list={["docs", { "has-subnav": hasSections }]}>
    <aside class="docs-pages">
      <DocsNav />
    </aside>

    <main id="docs-content">
      <article class="prose">
        <slot />
      </article>

      {
        sequencePagers.map(({ prev, next, sequence }, index) => (
          <nav
            class="pager"
            aria-label={sequence.title}
            data-doc-sequence={sequence.id}
            hidden={index > 0}
          >
            {prev && (
              <a rel={index === 0 ? "prev" : undefined} data-direction="prev" href={`${prev.url}?path=${sequence.id}`}>
                &larr; {prev.title}
              </a>
            )}
            {next && (
              <a rel={index === 0 ? "next" : undefined} data-direction="next" href={`${next.url}?path=${sequence.id}`}>
                {next.title} &rarr;
              </a>
            )}
          </nav>
        ))
      }
    </main>

    {
      hasSections && (
        <aside class="docs-onpage">
          <nav aria-labelledby="onpage-label">
            <span class="label" id="onpage-label">
              On this page
            </span>
            <DocsToc headings={headings} />
          </nav>
        </aside>
      )
    }
  </div>

  <SiteFooter />
</Minimal>

<style is:global>
  /* Scroll lock and bar handoff while a docs panel is open (see the toggle
   * script below). */
  body.docs-pane-open {
    overflow: hidden;
  }

  /* The subnav row collapses while the header menu is open so the menu
   * pane meets the site bar exactly. */
  body.docs-menu-open .subnav {
    display: none;
  }

  /* The "On this page" bar stays hidden at the top of the page and
   * appears once the reader scrolls into the content. Wide viewports
   * (96rem and up) show the outline beside the frame instead and never
   * render the bar. */
  body:not(.docs-scrolled) .subnav {
    display: none;
  }

  @media (max-width: 60rem) {
    body.docs-scrolled:not(.docs-menu-open) > header {
      padding-block-end: 0;
    }
  }
</style>

<style>
  .skip {
    position: absolute;
    left: -100vw;
  }

  .skip:focus {
    position: static;
    display: inline-block;
  }

  .docs {
    --docs-nav-width: 13rem;
    --docs-gap: 3rem;
    --subnav-height: 0rem;
    isolation: isolate;
    position: relative;
    display: grid;
    grid-template-columns:
      var(--docs-nav-width)
      minmax(0, calc(var(--frame-width) - var(--docs-nav-width) - var(--docs-gap)));
    column-gap: var(--docs-gap);
    margin-block: 3rem;
  }

  /* The column stretches with the article so the page list can stick
   * for the whole page. Search stays in flow and scrolls away. Overflow
   * stays visible so results can grow across the article. */
  .docs-pages {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: visible;
  }

  .docs-pages :global(.docs-index) {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .docs-pages :global([data-docs-nav]) {
    position: sticky;
    top: calc(var(--site-nav-height) + var(--subnav-height));
    max-height: calc(100vh - var(--site-nav-height) - var(--subnav-height));
    overflow-y: auto;
    scrollbar-width: thin;
    padding-block-end: 2rem;
  }

  /* Results overlay the article from the nav's left edge. Isolation on
   * .docs keeps this above in-page code frames and below the header. */
  .docs-pages:has(.docs-search .results:not([hidden])) {
    z-index: 1;
  }

  main {
    min-width: 0;
  }

  /* The page outline sits in the whitespace beside the frame and appears
   * only when that margin has room for it. */
  .docs-onpage {
    display: none;
  }

  /* The "On this page" bar: a second chrome row inside the sticky site
   * header (see the SiteNav "subnav" slot), so both rows share one
   * translucent surface. */
  .subnav {
    height: 2.75rem;
  }

  .subnav .bar {
    width: min(100%, var(--frame-width));
    margin-inline: auto;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .subnav summary {
    cursor: pointer;
    list-style: none;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subnav summary::-webkit-details-marker {
    display: none;
  }

  .subnav .current-section {
    color: var(--muted-color);
    margin-inline-start: 0.75rem;
  }

  /* The panel anchors below the chrome band with absolute positioning
   * against the sticky header. The open panel fills the viewport: the
   * toggle script docks the sticky chrome first and locks the page scroll. */
  .subnav .pane {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    height: calc(100vh - var(--site-nav-height) - 2.75rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--page-background);
    padding: 1.5rem var(--page-gutter) 2rem;
  }

  .subnav .pane-content {
    width: min(100%, var(--frame-width));
    margin-inline: auto;
  }

  .docs.has-subnav {
    --subnav-height: 2.75rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--content-width);
    margin-block-start: 3rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid GrayText;
  }

  .pager[hidden] {
    display: none;
  }

  .pager a[rel="next"] {
    margin-inline-start: auto;
    text-align: right;
  }

  /* Wide viewports: the outline replaces the bar. It uses the margin beside
   * the frame and grows with it, keeping clear space at the viewport edge.
   * 96rem is the first width that gives the rail 12rem, enough for one
   * identifier per line; below that the bar serves the outline. */
  @media (min-width: 96rem) {
    .subnav {
      display: none;
    }

    .docs.has-subnav {
      --subnav-height: 0rem;
    }

    .docs-onpage {
      display: block;
      position: absolute;
      inset-block: 0;
      left: calc(100% + 2rem);
      width: clamp(12rem, calc((100vw - 72rem) / 2), 13rem);
    }

    .docs-onpage nav {
      position: sticky;
      top: var(--site-nav-height);
      max-height: calc(100vh - var(--site-nav-height));
      overflow-y: auto;
      scrollbar-width: thin;
      padding-block-end: 2rem;
    }

    .docs-onpage .label {
      display: block;
      font-weight: 700;
      line-height: 1.6;
      margin-block-end: 0.25rem;
    }
  }

  @media (max-width: 60rem) {
    .docs {
      display: block;
      margin-block-start: 1.5rem;
    }

    .docs-pages {
      display: none;
    }
  }
</style>

<script>
  // Keep the current page visible inside the page list's own scroll area
  // without moving the document.
  const nav = document.querySelector(".docs-pages [data-docs-nav]")
  const link = nav?.querySelector("a[aria-current='page']")
  if (nav instanceof HTMLElement && link instanceof HTMLElement) {
    const linkTop = link.getBoundingClientRect().top - nav.getBoundingClientRect().top
    if (linkTop < 0 || linkTop > nav.clientHeight - 48) {
      nav.scrollTop += linkTop - nav.clientHeight / 3
    }
  }

  // The header menu and "On this page" disclosures open full-height panels
  // below the site chrome. Opening one closes the other, docks the header,
  // and locks the page scroll; following a link, clicking outside, or Escape
  // closes them again.
  const panels = Array.from(document.querySelectorAll<HTMLDetailsElement>("details.menu, details.onpage"))
  const header = document.querySelector("body > header")

  const sequencePagers = Array.from(document.querySelectorAll<HTMLElement>("[data-doc-sequence]"))
  const requestedSequence = new URL(window.location.href).searchParams.get("path")
  const activePager = sequencePagers.find((pager) => pager.dataset.docSequence === requestedSequence)
  if (activePager) {
    for (const pager of sequencePagers) {
      pager.hidden = pager !== activePager
      for (const link of pager.querySelectorAll("a")) {
        if (pager === activePager) link.rel = link.dataset.direction ?? ""
        else link.removeAttribute("rel")
      }
    }
  }

  function syncScrolled() {
    document.body.classList.toggle("docs-scrolled", window.scrollY > 0)
  }

  syncScrolled()
  window.addEventListener("scroll", syncScrolled, { passive: true })

  function sync() {
    document.body.classList.toggle(
      "docs-pane-open",
      panels.some((panel) => panel.open),
    )
    document.body.classList.toggle(
      "docs-menu-open",
      panels.some((panel) => panel.open && panel.classList.contains("menu")),
    )
  }

  function closeAll() {
    for (const panel of panels) panel.open = false
    sync()
  }

  for (const panel of panels) {
    panel.addEventListener("toggle", () => {
      if (panel.open) {
        for (const other of panels) {
          if (other !== panel) other.open = false
        }
        // Dock the sticky header so the fixed panel meets it exactly.
        const offset = header?.getBoundingClientRect().top ?? 0
        if (offset > 0) window.scrollBy(0, offset)
      }
      sync()
    })
  }

  if (panels.length > 0) {
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return
      const inside = panels.some((panel) => panel.contains(event.target as Element))
      if (inside && !event.target.closest("a")) return
      closeAll()
    })

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return
      const open = panels.find((panel) => panel.open)
      if (!open) return
      open.open = false
      sync()
      open.querySelector("summary")?.focus()
    })
  }
</script>
