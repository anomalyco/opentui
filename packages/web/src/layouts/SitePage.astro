---
import type { ComponentProps } from "astro/types"
import SiteFooter from "../components/SiteFooter.astro"
import SiteNav from "../components/SiteNav.astro"
import Minimal from "./Minimal.astro"
import "../styles/prose.css"

interface Props {
  title: string
  description: string
  /** Let the page use the full 64rem frame instead of the reading column. */
  wide?: boolean
  /** Step the content up to the 16px reading scale (see Minimal's .reading). */
  reading?: boolean
  footerLinks?: boolean
  footerAnimation?: ComponentProps<typeof SiteFooter>["animation"]
  robots?: string
}

const { title, description, wide = false, reading = false, footerLinks = false, footerAnimation, robots } = Astro.props
---

<Minimal {title} {description} wide {robots}>
  <SiteNav slot="nav" />
  <main class:list={[{ wide, reading }]}><slot /></main>
  <SiteFooter links={footerLinks} animation={footerAnimation} />
</Minimal>

<style>
  main {
    max-width: var(--content-width);
    margin-block: 3rem;
  }

  main.wide {
    max-width: none;
  }
</style>
