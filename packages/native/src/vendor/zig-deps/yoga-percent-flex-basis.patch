+// OpenTUI: whether a node's size on an axis comes from the root, its style, or
+// a stretch across a parent styled on that axis, and so not from its content.
+static bool hasDefinedSize(const yoga::Node* const node, Dimension axis) {
+  const auto styled = [axis](const yoga::Node* const n) {
+    const auto length = n->getProcessedDimension(axis);
+    return n->getOwner() == nullptr || length.isPoints() || length.isPercent();
+  };
+  const yoga::Node* const owner = node->getOwner();
+  return styled(node) ||
+      (styled(owner) &&
+       isRow(owner->style().flexDirection()) == (axis == Dimension::Height) &&
+       owner->style().flexWrap() == Wrap::NoWrap &&
+       resolveChildAlignment(owner, node) == Align::Stretch);
+}
+
+// OpenTUI: whether a defined flex basis must be resolved again in a new
+// layout: a percent basis, or percent padding (resolved against the owner
+// width), under a parent whose size it resolves against isn't content-sized.
+static bool resolvesAgainstDefinedOwner(
+    const yoga::Node* const node,
+    const yoga::Node* const child,
+    Dimension mainDimension) {
+  bool percentPadding = false;
+  for (auto edge : ordinals<Edge>()) {
+    percentPadding = percentPadding || child->style().padding(edge).isPercent();
+  }
+  return hasDefinedSize(node, mainDimension) &&
+      (percentPadding ? hasDefinedSize(node, Dimension::Width)
+                      : child->processFlexBasis().isPercent());
+}
