+  };
+  // STEP 7: a stretched row's layout at the line's cross size, or the row's
+  // cross position in the container's cross size.
+  const auto alignRow = [&](yoga::Node* child,
+                            float lineCross,
+                            float container) {
+    float leadingCrossDim = style.computeFlexStartPaddingAndBorder(
+        crossAxis, direction, ownerWidth);
+    const Align alignItem = resolveChildAlignment(node, child);
+    const auto& childStyle = child->style();
+    if (stretchesCross(child)) {
+      if (!child->hasDefiniteLength(Dimension::Width, innerWidth)) {
