+// OpenTUI: a list box replaces STEPs 3-7 with the steps that flex takes for a
+// child that does not flex in a single-line column: STEP 3's basis, STEP 5's
+// call, justifyMainAxis at flex-start, and STEP 7's alignment. Rows never grow
+// or shrink; the box's flexDirection, flexWrap, and justifyContent, a row's
+// flexBasis, and main-axis auto margins do not apply. Rows get no main-axis
+// owner size, so their percent heights and vertical insets, and a percent gap
+// without a definite height, resolve against an indefinite height. Each float
+// expression keeps the statement of the flex step it copies, so the compiler
+// contracts the same expressions.
+static void calculateListLayout(
+    yoga::Node* const node,
+    const Direction direction,
+    const float innerWidth,
+    const float availableInnerHeight,
+    const SizingMode widthSizingMode,
+    const SizingMode heightSizingMode,
+    const float ownerWidth,
+    const float ownerHeight,
+    const bool performLayout,
+    LayoutData& layoutMarkerData,
+    const uint32_t depth,
+    const uint32_t generationCount,
+    float& availableInnerMainDim,
+    float& maxLineMainDim,
+    float& totalLineCrossDim) {
+  const auto& style = node->style();
+  const FlexDirection mainAxis = FlexDirection::Column;
+  const FlexDirection crossAxis = resolveCrossDirection(mainAxis, direction);
+  const bool stretchFit = widthSizingMode == SizingMode::StretchFit;
+  const float paddingAndBorderCross =
+      paddingAndBorderForAxis(node, crossAxis, direction, ownerWidth);
+  const float gap = style.computeGapForAxis(
+      mainAxis,
+      heightSizingMode == SizingMode::StretchFit ? availableInnerHeight
+                                                 : YGUndefined);
+  const auto stretchesCross = [&](const yoga::Node* child) {
+    return resolveChildAlignment(node, child) == Align::Stretch &&
+        !child->style().flexStartMarginIsAuto(crossAxis, direction) &&
+        !child->style().flexEndMarginIsAuto(crossAxis, direction);
+  };
+  const auto stretches = [&](yoga::Node* child) {
+    return stretchesCross(child) &&
+        !child->hasDefiniteLength(Dimension::Width, innerWidth);
+  };
+  const auto margin = [&](const yoga::Node* child, FlexDirection axis) {
+    return child->style().computeMarginForAxis(axis, innerWidth);
+  };
+  const auto ratio = [](const yoga::Node* child) {
+    return child->style().aspectRatio().unwrap();
+  };
+  // constrainMaxSizeForMode on both axes, then the row's call.
+  const auto layoutRow = [&](yoga::Node* child,
+                             float width,
+                             SizingMode widthMode,
+                             float height,
+                             SizingMode heightMode,
+                             bool layout,
+                             LayoutPassReason reason) {
+    constrainMaxSizeForMode(
+        child,
+        direction,
+        crossAxis,
+        innerWidth,
+        innerWidth,
+        &widthMode,
+        &width);
+    constrainMaxSizeForMode(
+        child,
+        direction,
+        mainAxis,
+        YGUndefined,
+        innerWidth,
+        &heightMode,
+        &height);
+    calculateLayoutInternal(
+        child,
+        width,
+        height,
+        direction,
+        widthMode,
+        heightMode,
+        innerWidth,
+        YGUndefined,
+        layout,
+        reason,
+        layoutMarkerData,
+        depth,
+        generationCount);
+  };
+  // STEP 3 (computeFlexBasisForChild).
+  const auto basis = [&](yoga::Node* child) {
+    const float paddingAndBorder =
+        paddingAndBorderForAxis(child, mainAxis, direction, innerWidth);
+    if (child->hasDefiniteLength(Dimension::Height, YGUndefined)) {
+      return yoga::maxOrDefined(
+                 child->getResolvedDimension(
+                     direction, Dimension::Height, YGUndefined, innerWidth),
+                 FloatOptional(paddingAndBorder))
+          .unwrap();
+    }
+    const float marginRow = margin(child, FlexDirection::Row);
+    const float marginColumn = margin(child, FlexDirection::Column);
+    const bool hasAspectRatio = child->style().aspectRatio().isDefined();
+    const bool definiteWidth =
+        child->hasDefiniteLength(Dimension::Width, innerWidth);
+    float width = innerWidth;
+    float height = YGUndefined;
+    SizingMode widthMode = yoga::isDefined(innerWidth) ? SizingMode::FitContent
+                                                       : SizingMode::MaxContent;
+    SizingMode heightMode = SizingMode::MaxContent;
+    if (definiteWidth) {
+      width = child
+                  ->getResolvedDimension(
+                      direction, Dimension::Width, innerWidth, innerWidth)
+                  .unwrap() +
+          marginRow;
+      widthMode = SizingMode::StretchFit;
+    }
+    if (style.overflow() != Overflow::Scroll &&
+        yoga::isDefined(availableInnerHeight)) {
+      height = availableInnerHeight;
+      heightMode = SizingMode::FitContent;
+    }
+    if (hasAspectRatio && widthMode == SizingMode::StretchFit) {
+      height = marginColumn + (width - marginRow) / ratio(child);
+      heightMode = SizingMode::StretchFit;
+    }
+    if (!definiteWidth && stretchFit &&
+        resolveChildAlignment(node, child) == Align::Stretch) {
+      width = innerWidth;
+      widthMode = SizingMode::StretchFit;
+      if (hasAspectRatio) {
+        height = (width - marginRow) / ratio(child);
+        heightMode = SizingMode::StretchFit;
+      }
+    }
+    layoutRow(
+        child,
+        width,
+        widthMode,
+        height,
+        heightMode,
+        false,
+        LayoutPassReason::kMeasureChild);
+    return yoga::maxOrDefined(
+        child->getLayout().measuredDimension(Dimension::Height),
+        paddingAndBorder);
+  };
+  // STEP 5 (distributeFreeSpaceSecondPass) for a row that does not flex.
+  const auto measureRow = [&](yoga::Node* child, float mainSize, bool layout) {
+    const float marginMain = margin(child, mainAxis);
+    float width = innerWidth;
+    float height = mainSize + marginMain;
+    SizingMode widthMode = SizingMode::StretchFit;
+    if (child->style().aspectRatio().isDefined()) {
+      width = (height - marginMain) * ratio(child);
+      width += margin(child, crossAxis);
+    } else if (stretchFit && stretches(child)) {
+    } else if (!child->hasDefiniteLength(Dimension::Width, innerWidth)) {
+      widthMode = yoga::isUndefined(width) ? SizingMode::MaxContent
+                                           : SizingMode::FitContent;
+    } else {
+      width = child
+                  ->getResolvedDimension(
+                      direction, Dimension::Width, innerWidth, innerWidth)
+                  .unwrap() +
+          margin(child, crossAxis);
+      const bool isLoosePercentageMeasurement =
+          child->getProcessedDimension(Dimension::Width).isPercent() &&
+          !stretchFit;
+      widthMode = yoga::isUndefined(width) || isLoosePercentageMeasurement
+          ? SizingMode::MaxContent
+          : SizingMode::StretchFit;
+    }
+    layoutRow(
+        child,
+        width,
+        widthMode,
+        height,
+        SizingMode::StretchFit,
+        layout,
+        layout ? LayoutPassReason::kFlexLayout
+               : LayoutPassReason::kFlexMeasure);
+  };
+  // STEP 7: a stretched row's layout at the line's cross size, or the row's
+  // cross position in the container's cross size.
+  const auto alignRow = [&](yoga::Node* child,
+                            float lineCross,
+                            float container) {
+    float leadingCrossDim = style.computeFlexStartPaddingAndBorder(
+        crossAxis, direction, ownerWidth);
+    const Align alignItem = resolveChildAlignment(node, child);
+    const auto& childStyle = child->style();
+    if (stretchesCross(child)) {
+      if (!child->hasDefiniteLength(Dimension::Width, innerWidth)) {
+        float height = child->getLayout().measuredDimension(Dimension::Height);
+        float width = lineCross;
+        if (childStyle.aspectRatio().isDefined()) {
+          const float product = height * ratio(child);
+          width = margin(child, crossAxis) + product;
+        }
+        height += margin(child, mainAxis);
+        // Both sizes are defined, so constrainMaxSizeForMode keeps the modes.
+        layoutRow(
+            child,
+            width,
+            SizingMode::StretchFit,
+            height,
+            SizingMode::StretchFit,
+            true,
+            LayoutPassReason::kStretch);
+      }
+    } else {
+      const float remainingCrossDim =
+          container - child->dimensionWithMargin(crossAxis, innerWidth);
+      if (childStyle.flexStartMarginIsAuto(crossAxis, direction) &&
+          childStyle.flexEndMarginIsAuto(crossAxis, direction)) {
+        leadingCrossDim += yoga::maxOrDefined(0.0f, remainingCrossDim / 2);
+      } else if (childStyle.flexEndMarginIsAuto(crossAxis, direction)) {
+      } else if (childStyle.flexStartMarginIsAuto(crossAxis, direction)) {
+        leadingCrossDim += yoga::maxOrDefined(0.0f, remainingCrossDim);
+      } else if (alignItem == Align::FlexStart) {
+      } else if (alignItem == Align::Center) {
+        leadingCrossDim += remainingCrossDim / 2;
+      } else {
+        leadingCrossDim += remainingCrossDim;
+      }
+    }
+    child->setLayoutPosition(
+        child->getLayout().position(flexStartEdge(crossAxis)) + leadingCrossDim,
+        flexStartEdge(crossAxis));
+  };
+  // justifyMainAxis adds the gap before a row's size and no gap after the last
+  // row, so a row's size waits for the next row.
+  float mainDim =
+      style.computeFlexStartPaddingAndBorder(mainAxis, direction, ownerWidth);
+  float pendingMainDim = 0;
+  bool first = true;
+  const auto place = [&](yoga::Node* child, float size) {
+    if (!first) {
+      mainDim += gap;
+      mainDim += pendingMainDim;
+    }
+    first = false;
+    pendingMainDim = size;
+    if (performLayout) {
+      child->setLayoutPosition(
+          child->getLayout().position(flexStartEdge(mainAxis)) + mainDim,
+          flexStartEdge(mainAxis));
+    }
+  };
+  float lineCross = boundAxis(
+                        node,
+                        crossAxis,
+                        direction,
+                        innerWidth + paddingAndBorderCross,
+                        ownerWidth,
+                        ownerWidth) -
+      paddingAndBorderCross;
+  float sizeConsumed = 0;
+  float crossDim = 0;
+  float leadingGap = 0;
+  for (auto child : node->getLayoutChildren()) {
+    child->processDimensions();
+    if (child->style().display() == Display::None) {
+      if (performLayout) {
+        zeroOutLayoutRecursively(child);
+        child->setHasNewLayout(true);
+        child->setDirty(false);
+      }
+      continue;
+    }
+    const bool absolute =
+        child->style().positionType() == PositionType::Absolute;
+    if (performLayout) {
+      child->setPosition(
+          child->resolveDirection(direction),
+          innerWidth,
+          absolute ? availableInnerHeight : YGUndefined);
+    }
+    if (absolute) {
+      continue;
+    }
+    // A baseline reads the first row's line, which flex may have set.
+    child->setLineIndex(0);
+    const float mainSize = boundAxisWithinMinAndMax(
+                               child,
+                               direction,
+                               mainAxis,
+                               FloatOptional{basis(child)},
+                               YGUndefined,
+                               ownerWidth)
+                               .unwrap();
+    const float marginMain = margin(child, mainAxis);
+    sizeConsumed += mainSize + marginMain + leadingGap;
+    leadingGap = gap;
+    if (!stretchFit) {
+      measureRow(child, mainSize, performLayout && !stretches(child));
+      crossDim = yoga::maxOrDefined(
+          crossDim, child->dimensionWithMargin(crossAxis, innerWidth));
+    } else if (!performLayout) {
+      // A measure pass skips STEP 5 (canSkipFlex).
+      place(child, marginMain + mainSize);
+    } else {
+      measureRow(child, mainSize, !stretches(child));
+      place(child, child->dimensionWithMargin(mainAxis, innerWidth));
+      alignRow(child, lineCross, innerWidth);
+    }
+  }
+  if (!stretchFit) {
+    // The widest row sets the line, and STEP 7 stretches the others to it.
+    lineCross = boundAxis(
+                    node,
+                    crossAxis,
+                    direction,
+                    crossDim + paddingAndBorderCross,
+                    ownerWidth,
+                    ownerWidth) -
+        paddingAndBorderCross;
+    for (auto child : node->getLayoutChildren()) {
+      if (child->style().display() != Display::None &&
+          child->style().positionType() != PositionType::Absolute) {
+        place(child, child->dimensionWithMargin(mainAxis, innerWidth));
+        if (performLayout) {
+          alignRow(child, lineCross, lineCross);
+        }
+      }
+    }
+  }
+  if (!first) {
+    mainDim += pendingMainDim;
+  }
+  mainDim +=
+      style.computeFlexEndPaddingAndBorder(mainAxis, direction, ownerWidth);
+  maxLineMainDim = mainDim;
+  totalLineCrossDim += lineCross;
+  // STEP 5's clamp of the main size, which STEP 9 reads.
+  if (heightSizingMode != SizingMode::StretchFit) {
+    const float paddingAndBorderMain =
+        paddingAndBorderForAxis(node, mainAxis, direction, ownerWidth);
+    const float minInnerMainDim =
+        style
+            .resolvedMinDimension(
+                direction, Dimension::Height, ownerHeight, ownerWidth)
+            .unwrap() -
+        paddingAndBorderMain;
+    const float maxInnerMainDim =
+        style
+            .resolvedMaxDimension(
+                direction, Dimension::Height, ownerHeight, ownerWidth)
+            .unwrap() -
+        paddingAndBorderMain;
+    if (yoga::isDefined(minInnerMainDim) && sizeConsumed < minInnerMainDim) {
+      availableInnerMainDim = minInnerMainDim;
+    } else if (
+        yoga::isDefined(maxInnerMainDim) && sizeConsumed > maxInnerMainDim) {
+      availableInnerMainDim = maxInnerMainDim;
+    } else {
+      availableInnerMainDim = sizeConsumed;
+    }
+  }
+}
