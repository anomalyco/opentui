+// OpenTUI: a list box replaces STEPs 3-7 with the steps that flex takes for a
+// child that does not flex in a single-line column: STEP 3's basis, STEP 5's
+// call, justifyMainAxis at flex-start, and STEP 7's alignment. Rows never grow
+// or shrink; the box's flexDirection, flexWrap, and justifyContent, a row's
+// flexBasis, and main-axis auto margins do not apply. Rows get no main-axis
+// owner size, so their percent heights and vertical insets, and a percent gap
+// without a definite height, resolve against an indefinite height; and no
+// height cap, as in a column with overflow: scroll. Each float expression keeps
+// the statement of the flex step it copies, so the compiler contracts the same
+// expressions.
+//
+// A row's results depend only on the row and the slot key below, so a pass
+// reuses the stored results of a clean row instead of visiting it, and writes
+// its main position only when it moved. Sums run in the same order every pass.
+static bool sameBits(float a, float b) {
+  return std::bit_cast<uint32_t>(a) == std::bit_cast<uint32_t>(b);
+}
+
+static uint64_t nextListStamp() {
+  return gListStamp.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+#ifdef OT_YOGA_TEST_ALLOCATOR
+static void saveListRow(
+    yoga::Node* node,
+    std::vector<std::tuple<yoga::Node*, LayoutResults, bool>>& saved) {
+  saved.emplace_back(node, node->getLayout(), node->getHasNewLayout());
+  for (yoga::Node* child : node->getChildren()) {
+    saveListRow(child, saved);
+  }
+}
+#endif
