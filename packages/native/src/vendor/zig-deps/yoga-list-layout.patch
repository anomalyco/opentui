+    float width = innerWidth;
+    float height = mainSize + marginMain;
+    SizingMode widthMode = SizingMode::StretchFit;
+    if (child->style().aspectRatio().isDefined()) {
+      width = (height - marginMain) * ratio(child);
+      width += margin(child, crossAxis);
+    } else if (stretchFit && stretches(child)) {
+    } else if (!child->hasDefiniteLength(Dimension::Width, innerWidth)) {
+      widthMode = yoga::isUndefined(width) ? SizingMode::MaxContent
+                                           : SizingMode::FitContent;
+    } else {
