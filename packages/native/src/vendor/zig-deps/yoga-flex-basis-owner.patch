+// OpenTUI: whether a defined flex basis resolves a percentage against the
+// owner: a percent basis, or percent padding (resolved against the owner width).
+static bool hasPercentFlexBasisInput(const yoga::Node* const child) {
+  if (child->processFlexBasis().isPercent()) {
+    return true;
+  }
+  for (auto edge : ordinals<Edge>()) {
+    if (child->style().padding(edge).isPercent()) {
+      return true;
+    }
+  }
+  return false;
+}
