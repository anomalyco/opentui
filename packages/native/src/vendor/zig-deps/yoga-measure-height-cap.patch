+bool canUseMeasurementForLargerHeightCap(
+    const SizingMode widthMode,
+    const float availableWidth,
+    const SizingMode heightMode,
+    const float availableHeight,
+    const CachedMeasurement& cached,
+    const float marginColumn) {
+  // The cached size is below the old cap, so the cap did not clamp it. NaN
+  // fails every comparison.
+  const float lastSize = cached.availableHeight - marginColumn;
+  return cached.widthSizingMode == widthMode &&
+      cached.availableWidth == availableWidth &&
+      cached.heightSizingMode == SizingMode::FitContent &&
+      heightMode == SizingMode::FitContent &&
+      availableHeight - marginColumn > lastSize &&
+      cached.computedHeight < lastSize &&
+      !yoga::inexactEquals(cached.computedHeight, lastSize);
+}
+
