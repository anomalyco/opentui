+static bool hasPercentBoxLength(const Style& style) {
+  for (auto dimension : ordinals<Dimension>()) {
+    if (style.minDimension(dimension).unit() == Unit::Percent ||
+        style.maxDimension(dimension).unit() == Unit::Percent) {
+      return true;
+    }
+  }
+  for (auto edge : ordinals<Edge>()) {
+    if (style.margin(edge).unit() == Unit::Percent ||
+        style.padding(edge).unit() == Unit::Percent) {
+      return true;
+    }
+  }
+  return false;
+}
