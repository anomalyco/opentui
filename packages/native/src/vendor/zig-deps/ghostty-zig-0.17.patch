+fn ManagedPool(comptime Item: type, comptime alignment: ?std.mem.Alignment) type {
+    return struct {
+        const Self = @This();
+        const Unmanaged = std.heap.memory_pool.Extra(Item, .{ .alignment = alignment });
+        const ItemPtr = *align(Unmanaged.item_alignment.toByteUnits()) Item;
+        pub const item_size = Unmanaged.item_size;
+
+        allocator: Allocator,
+        unmanaged: Unmanaged,
+
+        pub fn initCapacity(allocator: Allocator, num: usize) Allocator.Error!Self {
+            return .{ .allocator = allocator, .unmanaged = try .initCapacity(allocator, num) };
+        }
+
+        pub fn deinit(self: *Self) void {
+            self.unmanaged.deinit(self.allocator);
+            self.* = undefined;
+        }
+
+        pub fn reset(self: *Self, mode: Unmanaged.ResetMode) bool {
+            return self.unmanaged.reset(self.allocator, mode);
+        }
+
+        pub fn create(self: *Self) Allocator.Error!ItemPtr {
+            return self.unmanaged.create(self.allocator);
+        }
+
+        pub fn destroy(self: *Self, ptr: ItemPtr) void {
+            self.unmanaged.destroy(ptr);
+        }
+    };
+}
 
