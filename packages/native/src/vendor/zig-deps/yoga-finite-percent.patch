diff --git a/yoga/style/StyleLength.h b/yoga/style/StyleLength.h
index 8099ce7d..8dc6383f 100644
--- a/yoga/style/StyleLength.h
+++ b/yoga/style/StyleLength.h
@@ -12,6 +12,12 @@
 
 namespace facebook::yoga {
 
+// OpenTUI: keep sums of resolved lengths finite. NaN stays undefined.
+constexpr float resolveFinitePercent(float percent, float referenceLength) {
+  const float resolved = percent * referenceLength * 0.01f;
+  return resolved > 1e30f ? 1e30f : resolved < -1e30f ? -1e30f : resolved;
+}
+
 /**
  * Style::Length represents a CSS Value which may be one of:
  * 1. Undefined
@@ -85,7 +91,8 @@ class StyleLength {
       case Unit::Point:
         return value_;
       case Unit::Percent:
-        return FloatOptional{value_.unwrap() * referenceLength * 0.01f};
+        return FloatOptional{
+            resolveFinitePercent(value_.unwrap(), referenceLength)};
       default:
         return FloatOptional{};
     }
