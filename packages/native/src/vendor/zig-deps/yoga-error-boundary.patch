diff --git a/yoga/OTAllocator.h b/yoga/OTAllocator.h
new file mode 100644
index 00000000..13d7ed82
--- /dev/null
+++ b/yoga/OTAllocator.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <new>
+#include <vector>
+
+namespace facebook::yoga::ot {
+#ifdef OT_YOGA_TEST_ALLOCATOR
+inline thread_local int64_t failAfter = -1;
+inline thread_local uint64_t allocationCount = 0;
+
+inline void beforeAllocation() {
+  if (failAfter == 0) {
+    throw std::bad_alloc{};
+  }
+  if (failAfter > 0) {
+    --failAfter;
+  }
+  ++allocationCount;
+}
+
+template <typename T> struct Allocator : std::allocator<T> {
+  using value_type = T;
+  Allocator() = default;
+  template <typename U> Allocator(const Allocator<U>&) noexcept {}
+  T* allocate(size_t count) {
+    beforeAllocation();
+    return std::allocator<T>::allocate(count);
+  }
+  template <typename U> struct rebind { using other = Allocator<U>; };
+};
+template <typename T> using Vector = std::vector<T, Allocator<T>>;
+#else
+inline void beforeAllocation() {}
+template <typename T> using Vector = std::vector<T>;
+#endif
+
+template <typename T, typename... Args>
+std::unique_ptr<T> makeUnique(Args&&... args) {
+  beforeAllocation();
+  return std::make_unique<T>(std::forward<Args>(args)...);
+}
+} // namespace facebook::yoga::ot
